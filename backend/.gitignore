# Dossiers de dépendances (Node.js)
# =================================
# Ignorer le dossier node_modules dans tous les sous-dossiers.
# C'est le plus important car il contient des milliers de fichiers lourds.
node_modules/
**/node_modules/

# Logs de NPM / Yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# Environnements virtuels (si vous utilisez Python, Ruby, etc.)
# ==========================================================
.venv/
env/
venv/
*.pyc  # Fichiers compilés Python
__pycache__/

# Fichiers d'environnement et secrets (CRUCIAL pour la sécurité)
# =============================================================
# Ne jamais committer des fichiers contenant des clés API,
# des identifiants de base de données, ou d'autres informations sensibles.
.env
.env.local
.env.*.local
!.env.example  # Permet de versionner un fichier .env.example vide comme template
# Si votre fichier backend/data/user.json contient des données sensibles
# qui ne devraient PAS être sur GitHub, décommentez la ligne ci-dessous :
# backend/data/user.json

# Fichiers de build et de compilation
# ==================================

# Frontend (Vite / React)
frontend/dist/          # Le dossier de sortie de la build de Vite
frontend/.vite/         # Fichiers temporaires/cache de Vite
frontend/build/         # Pour d'autres outils de build React

# Backend (si transpilation ou build)
backend/dist/
backend/build/

# Fichiers de configuration / cache temporaires
*.log
logs/                   # Dossier pour les logs
tmp/                    # Dossier pour les fichiers temporaires
*.sqlite3               # Base de données SQLite (si utilisée et temporaire)

# Fichiers spécifiques au système d'exploitation
# =============================================
.DS_Store               # macOS
Thumbs.db               # Windows
ehthumbs.db             # Windows
Desktop.ini             # Windows

# Fichiers spécifiques aux IDE (Integrated Development Environments)
# ================================================================
.idea/                  # Dossiers d'IDE JetBrains (IntelliJ, WebStorm, PhpStorm, etc.)
.vscode/                # Dossiers de VS Code
*.sublime-project       # Sublime Text
*.sublime-workspace     # Sublime Text
*.swp                   # Fichiers de swap de Vim
*.swo                   # Fichiers de swap de Vim

# Fichiers de test / Couverture de code
# ====================================
coverage/
.nyc_output/
*.info                  # Fichiers LCOV, etc.

# Fichiers divers générés
# =======================
.parcel-cache/          # Cache de Parcel
.next/                  # Build de Next.js
.nuxt/                  # Build de Nuxt.js
.cache/                 # Cache général
.eslintcache            # Cache d'ESLint
.prettiercache          # Cache de Prettier
